# Copy to .env and fill in. setup.sh does this for you and generates the secret.

# Image installs: the release bundle fills this with an immutable image digest.
# Source installs: setup.sh always builds mtg:local from this checkout.
MTG_IMAGE=mtg:local

# Signs session cookies; any long random string. setup.sh generates one.
APP_SECRET_KEY=change-me-to-a-long-random-string
# Minutes of inactivity before a user is logged out.
SESSION_IDLE_MINUTES=30
# Marks the session cookie Secure and redirects HTTP to HTTPS. Set false only
# when running without TLS (a bare uvicorn), or login appears to fail silently.
HTTPS_ONLY=true

# Postgres and Redis. Docker compose overrides these per service; the values
# below are for running the app directly on the host.
DATABASE_URL=postgresql+psycopg://mtg:mtg@localhost:5432/mtg
REDIS_URL=redis://localhost:6379/0
# Local filesystem root for uploaded PDFs and rendered page images.
STORAGE_DIR=./storage

# Text model for generated content (rule compilation, reports). URL needs /v1.
GENERATION_BASE_URL=http://your-llm-host:8001/v1
GENERATION_API_KEY=EMPTY
GENERATION_MODEL=your-text-model-name
# The served model's real context window; setting it too high makes long
# requests fail. The two budgets below reserve output space inside it.
GENERATION_MAX_MODEL_LEN=65536
REPORT_OUTPUT_TOKEN_BUDGET=8192
CHAT_OUTPUT_TOKEN_BUDGET=16384
# Per-attempt call timeout in seconds, and application-level retries.
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2

# Vision model for page extraction (typically vLLM on a GPU machine). Without
# it uploads are stored but extraction fails. URL needs /v1.
EXTRACTION_BASE_URL=http://your-vlm-host:8000/v1
EXTRACTION_API_KEY=EMPTY
# Model name as served by the endpoint; NuExtract3 recommended.
EXTRACTION_MODEL=numind/NuExtract3
# "nuextract-markdown" for NuExtract3's native mode, or "prompt" for a generic
# vision model driven by app/prompt/page_extraction.j2.
EXTRACTION_MODE=nuextract-markdown

# Embedding model for page indexing and the materials chat. URL needs /v1.
EMBEDDING_BASE_URL=http://your-embed-host:8002/v1
EMBEDDING_API_KEY=EMPTY
# Must emit 768-dimension vectors, to match EMBEDDING_DIM in app/models.
EMBEDDING_MODEL=your-embedding-model-name
# Page markdowns sent per /v1/embeddings request.
EMBEDDING_BATCH_SIZE=8
# Pages the materials chat retrieves per question (recall vs. context noise).
MATERIALS_RETRIEVAL_K=8

# Maximum accepted PDF upload, in megabytes.
MAX_UPLOAD_MB=50
# Resolution used when rendering PDF pages to images.
PDF_RENDER_DPI=150

# Pages extracted in parallel per document. Raise only with spare VLM capacity.
PAGE_EXTRACTION_CONCURRENCY=12
# Pages whose rule evidence is extracted in parallel within one document. Keep
# below the vLLM server's max_concurrency so one analysis leaves headroom.
EVIDENCE_EXTRACTION_CONCURRENCY=8
# Documents whose report prose is generated in parallel in one report pass.
REPORT_GENERATION_CONCURRENCY=8
# Report-analysis RQ workers. At 1, courses queue instead of splitting the
# model server's throughput between concurrent runs.
REPORT_WORKER_REPLICAS=1

# Host ports for the reverse proxy. setup.sh picks these (80/443, else 8089+).
HTTP_PORT=80
HTTPS_PORT=443
